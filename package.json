{
  "name": "menager-mcp",
  "version": "3.0.0",
  "license": "GPL-3.0-or-later",
  "description": "A TypeScript-based MCP server for inter-session terminal orchestration, pseudo-terminal (PTY) lifecycle management, ring-buffered I/O multiplexing, and reactive event hooking across polyglot execution harnesses.",
  "type": "module",
  "bin": {
    "menager": "./build/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x build/index.js",
    "watch": "tsc --watch",
    "start": "node build/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "node-pty": "^1.1.0-beta11",
    "strip-ansi": "^6.0.1",
    "tree-kill": "^1.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "fast-uri": "^3.1.7"
  }
}
